@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@400;500;600&display=swap');

:root{--bg:#0b0d0b;--paper:#e9e6dc;--muted:#9b9a91;--line:#2b2d28;--accent:#c8b98a}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--paper);font-family:Inter,Arial,sans-serif}button,input,textarea{font:inherit}button{cursor:pointer}
.nav{position:fixed;z-index:20;top:0;left:0;right:0;height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 4vw;background:linear-gradient(#080a08,transparent);backdrop-filter:blur(8px)}
.brand{border:0;background:none;color:var(--paper);display:flex;align-items:center;gap:12px;font-size:12px;letter-spacing:.14em;font-weight:700}.brand-mark{width:36px;height:36px;border:1px solid #77766d;border-radius:50%;display:grid;place-items:center;font-family:Oswald;font-size:11px}
.nav nav{display:flex;gap:26px}.nav nav button{border:0;background:none;color:#aaa;font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:12px 0}.nav nav button:hover,.nav nav button.active{color:#fff;border-bottom:1px solid var(--accent)}
.hero{height:100svh;min-height:680px;position:relative;overflow:hidden;display:flex;align-items:flex-end;padding:0 8vw 10vh}.hero-image{position:absolute;inset:0;background-image:url('/images/bogdan-war.png');background-size:cover;background-position:center 25%;filter:saturate(.55) contrast(1.08)}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,7,5,.86),rgba(5,7,5,.15) 70%),linear-gradient(0deg,rgba(5,7,5,.9),transparent 55%)}.hero-copy{position:relative;max-width:900px}.eyebrow,.section-kicker{font-size:10px;letter-spacing:.2em;color:#b8b6ab}.hero h1{font-family:Oswald,Impact,sans-serif;font-size:clamp(70px,11vw,170px);line-height:.82;letter-spacing:-.035em;margin:22px 0}.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1px #ddd9cb}.lead{max-width:560px;color:#c6c4bb;font-size:17px;line-height:1.6}.primary{border:1px solid #888477;background:#d8d2c0;color:#111;padding:15px 19px;margin-top:22px;font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-weight:800}.primary span{margin-left:28px}.hero-side{position:absolute;right:4vw;bottom:5vh;color:#888;font:12px Oswald;line-height:1.8;letter-spacing:.15em;text-align:right}
.section{padding:130px 8vw;border-top:1px solid var(--line)}.section-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:10vw;margin-top:50px}.section h2{font:500 clamp(55px,8vw,120px)/.9 Oswald;margin:0;letter-spacing:-.035em}.section h2 span{color:#73746d}.bio-text{max-width:680px}.bio-text p{color:#aaa9a0;line-height:1.8}.bio-text .big{font-size:24px;color:#dedbd1;line-height:1.4}.timeline{border-top:1px solid var(--line);margin-top:55px}.timeline div{display:grid;grid-template-columns:120px 1fr;padding:19px 0;border-bottom:1px solid var(--line);font-size:13px}.timeline b{color:var(--accent);font-weight:500}.timeline span{color:#aaa}
.quote{padding:150px 8vw;background:#151813;border-top:1px solid var(--line);position:relative}.quote-mark{font:160px/0.5 Oswald;color:#4b4d45}.quote blockquote{font:500 clamp(38px,5.5vw,78px)/1.03 Oswald;max-width:1100px;margin:35px 0 0;letter-spacing:-.02em}
.section-head{display:flex;justify-content:space-between;gap:40px;align-items:flex-end;margin-bottom:55px}.section-head>p{max-width:350px;color:#8e8f88;font-size:13px;line-height:1.7}.gallery-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:12px}.photo{position:relative;overflow:hidden;border:0;padding:0;background:#151714;min-height:280px}.photo img{width:100%;height:100%;display:block;object-fit:cover;transition:transform .7s,filter .7s;filter:saturate(.65)}.photo:hover img{transform:scale(1.04);filter:saturate(.9)}.photo-caption{position:absolute;left:18px;right:18px;bottom:15px;text-align:left;text-shadow:0 2px 12px #000}.photo-caption b,.photo-caption small{display:block}.photo-caption b{font-size:14px}.photo-caption small{font-size:9px;text-transform:uppercase;letter-spacing:.16em;color:#bbb;margin-top:5px}.photo-0{grid-column:span 7;grid-row:span 2;min-height:650px}.photo-1,.photo-2,.photo-3,.photo-4,.photo-5,.photo-6{grid-column:span 5;min-height:310px}.photo-1{grid-column:span 5}.photo-2{grid-column:span 5}.photo-3{grid-column:span 4}.photo-4{grid-column:span 4}.photo-5{grid-column:span 4}.photo-6{grid-column:span 4}
.contacts{background:#11140f}.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:10vw;margin-top:55px}.contact-layout p{color:#91928a;max-width:430px;line-height:1.7}form{max-width:520px}label{display:block;color:#8c8d84;font-size:9px;letter-spacing:.18em;margin-bottom:22px}input,textarea{width:100%;margin-top:8px;border:0;border-bottom:1px solid #3a3c36;background:transparent;color:#eee;padding:12px 0;outline:none;resize:vertical}input:focus,textarea:focus{border-color:#aaa}form .primary{margin-top:0}
footer{display:flex;justify-content:space-between;padding:28px 8vw;border-top:1px solid var(--line);color:#66685f;font-size:9px;letter-spacing:.18em}
.lightbox{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.94);display:grid;place-items:center;padding:5vh 5vw}.lightbox img{max-width:90vw;max-height:90vh;object-fit:contain}.close{position:absolute;right:28px;top:20px;background:none;border:0;color:#fff;font-size:44px;font-weight:200}
@media(max-width:800px){.nav{height:62px;padding:0 5vw}.nav nav{gap:12px}.nav nav button{font-size:8px}.brand span:last-child{display:none}.hero{padding:0 6vw 9vh;min-height:620px}.hero h1{font-size:22vw}.lead{font-size:14px}.section{padding:90px 6vw}.section-grid,.contact-layout{grid-template-columns:1fr;gap:45px}.section-head{display:block}.section-head>p{margin-top:30px}.gallery-grid{display:grid;grid-template-columns:1fr 1fr}.photo-0,.photo-1,.photo-2,.photo-3,.photo-4,.photo-5,.photo-6{grid-column:auto;grid-row:auto;min-height:260px}.photo-0{grid-column:span 2;min-height:480px}.quote{padding:100px 6vw}.quote blockquote{font-size:45px}footer{padding:25px 6vw;display:block}footer span{display:block;margin:8px 0}}
